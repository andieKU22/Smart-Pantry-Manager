<?xml version="1.0" encoding="utf-8"?>

<!-- Scrollable layout for the Recipe Detail screen. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Main vertical container. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Displays the recipe name. -->
        <TextView
            android:id="@+id/recipeDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textStyle="bold"
            android:paddingBottom="15dp" />

        <!-- Heading for the ingredients section. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Required Ingredients"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <!-- Displays the full ingredient list. -->
        <TextView
            android:id="@+id/recipeDetailIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:paddingBottom="20dp" />

        <!-- Heading for the method section. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Method"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <!-- Displays the preparation instructions. -->
        <TextView
            android:id="@+id/recipeDetailInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:paddingBottom="20dp" />

        <!-- Returns to the Suggested Recipes screen. -->
        <Button
            android:id="@+id/backToRecipesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Suggested Recipes" />

    </LinearLayout>

</ScrollView>